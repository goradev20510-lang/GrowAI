# Copy to .env. All values are optional for local use.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
LLM_ENABLED=1
LLM_NARRATION_HINTS=1
LLM_MATCH_EXPLANATIONS=0
LLM_MASK_SENSITIVE=1
# In production, set to 1 to allow sending (masked) document text to the model provider.
# LLM_DATA_CONSENT=0

# APP_ENV=production turns login on.
# RECONCILE_AUTH=1
# RECONCILE_ADMIN_USER=
# RECONCILE_ADMIN_PASSWORD=
# RECONCILE_CORS=http://localhost:3000,http://127.0.0.1:3000

# DATABASE_PATH=database/reconcile.db
# RECONCILE_MAX_ROUNDING=100

# Mailbox import (use an app password)
# IMAP_HOST=
# IMAP_USER=
# IMAP_PASSWORD=
# IMAP_FOLDER=INBOX
